# Image Classification API - Environment Configuration
# Copy this file to .env and configure your settings

# =============================================================================
# Server Configuration
# =============================================================================

# Host and port for the API server
HOST=0.0.0.0
PORT=8001

# Maximum file size for uploads (in MB)
MAX_FILE_SIZE_MB=50

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# AI Model Configuration
# =============================================================================

# Device for model inference: 'cuda' for GPU, 'cpu' for CPU
DEVICE=cuda

# Confidence threshold for predictions (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.7

# =============================================================================
# Optional Settings
# =============================================================================

# Model cache directory (leave empty for default)
MODEL_CACHE_DIR=/opt/image-classification-api/models

# Enable debug mode (set to 'true' for development)
DEBUG=false

# Request timeout in seconds
REQUEST_TIMEOUT=30
